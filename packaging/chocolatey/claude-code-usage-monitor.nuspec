  <metadata>
    <id>claude-code-usage-monitor</id>
    <version>__VERSION__</version>
    <title>Claude Code Usage Monitor</title>
    <authors>Code Zeno Pty Ltd</authors>
    <owners>CodeZeno</owners>
    <projectUrl>https://github.com/CodeZeno/Claude-Code-Usage-Monitor</projectUrl>
    <projectSourceUrl>https://github.com/CodeZeno/Claude-Code-Usage-Monitor</projectSourceUrl>
    <docsUrl>https://github.com/CodeZeno/Claude-Code-Usage-Monitor/blob/main/docs/chocolatey.md</docsUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/CodeZeno/Claude-Code-Usage-Monitor@main/src/icons/256x256.png</iconUrl>
    <packageSourceUrl>https://github.com/CodeZeno/Claude-Code-Usage-Monitor/tree/main/packaging/chocolatey</packageSourceUrl>
