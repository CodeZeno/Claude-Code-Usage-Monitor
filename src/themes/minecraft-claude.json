{
  "schema_version": 1,
  "id": "theme-minecraft-claude",
  "name": "Minecraft (Claude)",
  "surfaces": [
    {
      "id": "mcc-surface",
      "name": "Minecraft",
      "render": "1",
      "visibility": "100",
      "placement": {
        "reference": {
          "region": "system_tray",
          "display": 0
        },
        "nest": "taskbar",
        "horizontal": "left",
        "vertical": "bottom",
        "surface_horizontal": "right",
        "surface_vertical": "bottom",
        "offset_x": -4,
        "offset_y": 0
      },
      "width": "196",
      "height": "44",
      "background": {
        "type": "none"
      },
      "border": null,
      "mouse_events": {
        "double_click": "show_dashboard()",
        "right_click": "show_context_menu(\"dashboard-v2\")"
      },
      "corner_radius": "0",
      "layout": "freeform",
      "align": "start",
      "gap": "0",
      "content": {
        "type": "none"
      },
      "children": [
        {
          "id": "mcc-hearts",
          "name": "Hearts (weekly)",
          "render": "1",
          "visibility": "100",
          "y": "5",
          "width": "142",
          "height": "16",
          "background": {
            "type": "none"
          },
          "border": null,
          "corner_radius": "0",
          "layout": "freeform",
          "align": "start",
          "gap": "0",
          "content": {
            "type": "none"
          }
        },
        {
          "id": "mcc-hearts-empty",
          "name": "Hearts Empty",
          "render": "1",
          "visibility": "100",
          "parent": "mcc-hearts",
          "width": "142",
          "height": "16",
          "background": {
            "type": "image",
            "path": "assets/minecraft-claude-hearts-empty.png",
            "fit": "contain"
          },
          "border": null,
          "corner_radius": "0",
          "layout": "freeform",
          "align": "start",
          "gap": "0",
          "content": {
            "type": "none"
          }
        },
        {
          "id": "mcc-hearts-full-clip",
          "name": "Hearts Full Container",
          "render": "1",
          "visibility": "100",
          "parent": "mcc-hearts",
          "width": "floor((104 - clamp(round(claude.weekly.percentage), 0, 100)) / 5) * 7 + 2",
          "height": "16",
          "background": {
            "type": "none"
          },
          "border": null,
          "corner_radius": "0",
          "layout": "freeform",
          "align": "start",
          "gap": "0",
          "content": {
            "type": "none"
          }
        },
        {
